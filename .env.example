OPENROUTER_API_KEY=
DADATA_API_KEY=
DADATA_SECRET_KEY=

POWER_WEB_OS_DATABASE_URL=sqlite:///./demo/output/power_web_os.sqlite3
POWER_WEB_OS_CELERY_BROKER_URL=redis://localhost:6379/0
POWER_WEB_OS_CELERY_RESULT_BACKEND=redis://localhost:6379/1
POWER_WEB_OS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Docker host bindings. Container ports remain API 8000 and Redis 6379.
POWER_WEB_OS_API_HOST_PORT=8001
POWER_WEB_OS_REDIS_HOST_PORT=6380
VITE_POWER_WEB_OS_API_BASE_URL=http://127.0.0.1:8001

# Manual local API port for `power-web-os-api` / `python -m power_web_os.api`.
POWER_WEB_OS_API_PORT=8000

# Non-secret Radar defaults live in config/radar/*.json.
# Use this only for emergency/deployment overrides.
POWER_WEB_OS_RADAR_CONFIG_DIR=config/radar
