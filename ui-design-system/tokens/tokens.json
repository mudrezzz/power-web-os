{
  "$meta": {
    "name": "Power Web OS — Design Tokens",
    "version": "1.0.0",
    "description": "Framework-agnostic token export. Source of truth is ../colors_and_type.css (CSS custom properties). Token names below match the CSS variable names without the leading --.",
    "note": "Colors are sRGB hex. Use these for design-token tooling (Style Dictionary, Tailwind config, Figma Tokens, etc.). The --focus-ring CSS var is derived at runtime via color-mix; its resolved value is given here for convenience."
  },

  "font": {
    "sans": "'Hanken Grotesk', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace"
  },

  "color": {
    "neutral": {
      "paper":        "#FBFBF9",
      "surface":      "#FFFFFF",
      "surface-2":    "#F5F5F2",
      "surface-3":    "#EDEDE9",
      "border-faint": "#EEEEE9",
      "border":       "#E3E3DD",
      "border-strong":"#D2D2CA",
      "ink":          "#191B1E",
      "fg2":          "#565A60",
      "fg3":          "#888D94",
      "fg4":          "#B2B6BC"
    },
    "cobalt": {
      "50":  "#EEF1FE",
      "100": "#DCE3FD",
      "200": "#BCC8FB",
      "base":"#2D52E0",
      "600": "#2747C8",
      "700": "#1F3AA6"
    },
    "stance": {
      "ally":           "#14935F",
      "ally-tint":      "#E7F4EE",
      "ally-200":       "#B7E0CC",
      "blocker":        "#DB4A45",
      "blocker-tint":   "#FBEBEA",
      "blocker-200":    "#F4C4C1",
      "unsurfaced":     "#C2851A",
      "unsurfaced-tint":"#F8F0DD",
      "unsurfaced-200": "#ECD49B",
      "neutral":        "#888D94"
    },
    "semantic": {
      "accent":      "#2D52E0",
      "accent-tint": "#EEF1FE",
      "link":        "#2747C8",
      "success":     "#14935F",
      "danger":      "#DB4A45",
      "warning":     "#C2851A",
      "focus-ring":  "rgba(45, 82, 224, 0.45)"
    }
  },

  "radius": {
    "xs":   "6px",
    "sm":   "8px",
    "md":   "10px",
    "lg":   "14px",
    "xl":   "18px",
    "2xl":  "24px",
    "pill": "999px"
  },

  "shadow": {
    "xs":    "0 1px 2px rgba(25, 27, 30, 0.05)",
    "sm":    "0 1px 2px rgba(25, 27, 30, 0.04), 0 2px 6px rgba(25, 27, 30, 0.05)",
    "md":    "0 2px 4px rgba(25, 27, 30, 0.04), 0 8px 20px rgba(25, 27, 30, 0.07)",
    "lg":    "0 4px 8px rgba(25, 27, 30, 0.05), 0 18px 40px rgba(25, 27, 30, 0.10)",
    "focus": "0 0 0 3px rgba(45, 82, 224, 0.45)"
  },

  "space": {
    "1":  "4px",
    "2":  "8px",
    "3":  "12px",
    "4":  "16px",
    "5":  "20px",
    "6":  "24px",
    "8":  "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px"
  },

  "motion": {
    "ease":      "cubic-bezier(0.22, 0.61, 0.36, 1)",
    "dur-fast":  "120ms",
    "dur":       "200ms",
    "dur-slow":  "360ms"
  },

  "typography": {
    "display": { "weight": 700, "size": "44px",   "lineHeight": 1.05, "tracking": "-0.025em", "family": "sans" },
    "h1":      { "weight": 650, "size": "32px",   "lineHeight": 1.12, "tracking": "-0.018em", "family": "sans" },
    "h2":      { "weight": 650, "size": "24px",   "lineHeight": 1.18, "tracking": "-0.015em", "family": "sans" },
    "h3":      { "weight": 600, "size": "19px",   "lineHeight": 1.25, "tracking": "-0.01em",  "family": "sans" },
    "h4":      { "weight": 600, "size": "16px",   "lineHeight": 1.3,  "tracking": "-0.006em", "family": "sans" },
    "body-lg": { "weight": 400, "size": "17px",   "lineHeight": 1.55, "tracking": "0",        "family": "sans" },
    "body":    { "weight": 400, "size": "15px",   "lineHeight": 1.55, "tracking": "0",        "family": "sans" },
    "body-sm": { "weight": 400, "size": "13.5px", "lineHeight": 1.5,  "tracking": "0",        "family": "sans" },
    "label":   { "weight": 550, "size": "13px",   "lineHeight": 1.2,  "tracking": "0",        "family": "sans" },
    "meta":    { "weight": 500, "size": "12px",   "lineHeight": 1.3,  "tracking": "0",        "family": "sans" },
    "mono":    { "weight": 460, "size": "13px",   "lineHeight": 1.45, "tracking": "0",        "family": "mono" },
    "mono-sm": { "weight": 460, "size": "11.5px", "lineHeight": 1.4,  "tracking": "0",        "family": "mono" },
    "eyebrow": { "weight": 460, "size": "11.5px", "lineHeight": 1.4,  "tracking": "0.14em",   "family": "mono", "transform": "uppercase" }
  }
}
