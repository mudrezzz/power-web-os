    {
      "code": "LIVE-SCHEMA-01",
      "finding": "Live provider confidence aliases were broader than the application contract.",
      "resolution": "Normalize provider confidence values before contract validation and cover aliases with adapter tests."
    },
    {
      "code": "LIVE-LANE-01",
      "finding": "A broad OpenRouter capability card could collapse official and open-web routing.",
      "resolution": "Compile explicit lane tasks and require a terminal ledger entry for every selected decision."
    },
    {
      "code": "LIVE-ENTITY-01",
      "finding": "Known-source retrieval could return evidence for another SIBUR entity.",
      "resolution": "Validate candidate identity and enforce the requested known-source URL family before accepting evidence."
    },
    {
      "code": "LIVE-DED-01",
      "finding": "Summary-based fingerprints were unstable across incremental provider responses.",
      "resolution": "Persist candidate-signal-source URL keys and suppress overlap matches independently of generated wording."
    },
    {
      "code": "PROCESS-IMAGE-01",
      "finding": "One verification run used a stale API image after a worker-only rebuild.",
      "resolution": "Rebuild the complete Docker stack before final live evidence and inspect the queued input snapshot before acceptance."
    }
  ]
